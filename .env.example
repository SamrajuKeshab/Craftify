# ==============================================================================
# CRAFTIFY FRONTEND ENVIRONMENT VARIABLES (Vite + React .jsx)
# ==============================================================================
# Copy this file to `.env` for local development in VS Code.

# Base URL for your local Django REST Framework backend (run via `python manage.py runserver`)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# Public Razorpay Key ID (safe for client-side Checkout modal; NEVER put Key Secret here)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# App URL (used for links and callbacks)
APP_URL="http://localhost:3000"
