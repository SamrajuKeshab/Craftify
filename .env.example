# ==============================================================================
# CRAFTIFY FRONTEND ENVIRONMENT VARIABLES (Vite + React .jsx)
# ==============================================================================
# Copy this file to `.env` for local development in VS Code.

# Base URL for Craftify Django REST Framework API.
# Leave as "/api/v1" locally in VS Code (Vite proxies /api -> http://127.0.0.1:8000 for same-origin HttpOnly cookies).
# In production (Vercel), set this to your Render URL (e.g., https://craftify-api.onrender.com/api/v1).
VITE_API_BASE_URL="/api/v1"

# Public Razorpay Key ID (safe for client-side Checkout modal; NEVER put Key Secret here)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# App URL (used for links and callbacks)
APP_URL="http://localhost:3000"
