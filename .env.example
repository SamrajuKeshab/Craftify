# ==============================================================================
# CRAFTIFY FRONTEND ENVIRONMENT VARIABLES (Vite + React .jsx)
# ==============================================================================
# Copy this file to `.env` for local development in VS Code.

# Base URL for Craftify Django REST Framework API.
# Leave as "/api/v1" BOTH locally (Vite proxy) AND on Vercel (vercel.json /api/:path* proxy to Render)
# so browsers stay strictly same-origin and HttpOnly SameSite=Lax refresh cookies work reliably everywhere.
VITE_API_BASE_URL="/api/v1"

# Public Razorpay Key ID (safe for client-side Checkout modal; NEVER put Key Secret here)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Public Frontend URL (e.g. http://localhost:3000 locally or https://craftify.vercel.app in production)
APP_URL="http://localhost:3000"
