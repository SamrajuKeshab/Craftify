# ==============================================================================
# CRAFTIFY DJANGO BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to `backend/.env` before running `python manage.py runserver`.
# NEVER commit `backend/.env` or real production secrets to GitHub!

# Use config.settings.dev locally and config.settings.prod on Render
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration (Local VS Code)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=craftify_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Render Production PostgreSQL (automatically injected via render.yaml)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL_REQUIRE=True

# Optional: Set to True ONLY for quick SQLite testing before installing PostgreSQL
USE_SQLITE_FALLBACK=False

# Frontend URL, CORS & CSRF Trusted Origins
# Locally: http://localhost:3000
# On Render: https://your-craftify-app.vercel.app
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REFRESH_COOKIE_SAMESITE=Lax

# Razorpay Payment Gateway (Test Mode for local & Week 12 Render webhook validation)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# Set in Render after creating webhook URL: https://<your-render-service>.onrender.com/api/v1/payments/razorpay/webhook/
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary Media Storage (provide either CLOUDINARY_URL OR all three values below)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Production SMTP Email Delivery (Gmail App Password, Brevo, or Resend)
# Gmail:   EMAIL_HOST=smtp.gmail.com   | EMAIL_PORT=587 | EMAIL_USE_TLS=True
# Brevo:   EMAIL_HOST=smtp-relay.brevo.com | EMAIL_PORT=587 | EMAIL_USE_TLS=True
# Resend:  EMAIL_HOST=smtp.resend.com  | EMAIL_PORT=587 | EMAIL_USE_TLS=True (EMAIL_HOST_USER=resend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Craftify <noreply@craftify.in>
